# Python
__pycache__/
*.pyc
venv/
.venv/

# Trained artifacts (generated by scripts/bootstrap.py; metadata JSON is committed)
*.pkl

# Processed data (regenerated by scripts/bootstrap.py)
*.parquet

# Local/demo persistence (created on first /api/analyze call)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Node
node_modules/

# Env files (never commit local overrides)
.env
.env.*
!.env.example

# Editor / assistant tooling
.claude/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Large raw datasets — users download these separately (see README Quickstart)
data/raw/*.csv

# Next.js build output
frontend/.next/
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
