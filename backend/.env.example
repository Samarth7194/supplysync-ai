# SupplySync backend — environment variables.
# Copy to backend/.env (or export in your shell) before running uvicorn.

# --- Model + data paths -----------------------------------------------------
# Where ModelService loads/saves artifacts. The lifespan honors this.
MODEL_PATH=backend/saved_models

# --- Evidence-based forecast routing ---------------------------------------
# When enabled, SupplySync can use trustworthy forecast_evaluation evidence to
# choose among existing methods. Safe demand-pattern defaults remain the
# fallback whenever evidence is missing, stale, horizon-incompatible, or too
# small to trust.
EVIDENCE_ROUTING_ENABLED=false
ROUTING_PRIMARY_METRIC=wape
ROUTING_MIN_EVALUATION_POINTS=30
ROUTING_MIN_RELATIVE_IMPROVEMENT=0.05
ROUTING_EVIDENCE_LOOKBACK_DAYS=365

# Forecast-error uncertainty. When enough completed logged predictions have
# been evaluated for a compatible horizon, safety stock can use residual
# sigma instead of falling back to historical demand standard deviation.
UNCERTAINTY_MIN_RESIDUAL_OBSERVATIONS=30
UNCERTAINTY_RESIDUAL_LOOKBACK_DAYS=365

# Phase A model monitoring summarizes completed forecast_evaluations only.
# It does not perform drift detection, retraining, or promotion.
MODEL_MONITORING_ENABLED=true
MODEL_MONITORING_WINDOW_EVALUATIONS=30
MODEL_MONITORING_LOOKBACK_DAYS=90
MODEL_MONITORING_MIN_EVALUATIONS=30
MODEL_MONITORING_WAPE_WARNING_THRESHOLD=0.15
MODEL_MONITORING_WAPE_DEGRADATION_THRESHOLD=0.25
MODEL_MONITORING_BIAS_WARNING_RATIO=0.20
MODEL_MONITORING_DEGRADATION_CONSECUTIVE_RUNS=2

# Phase E may recommend retraining from completed monitoring evidence, but it
# never trains automatically. Keep AUTO_RETRAIN_ENABLED=false unless a future
# execution phase wires a human-approved retraining job.
AUTO_RETRAIN_ENABLED=false
MODEL_RETRAIN_MIN_EVALUATED_FORECAST_DAYS=100
MODEL_RETRAIN_COOLDOWN_DAYS=14
MODEL_RETRAIN_REQUIRE_DEGRADED_STATUS=true

# --- Default planning assumptions used by the simulation script -------------
# The live /api/analyze route accepts per-request overrides via
# `lead_time_days` and `service_level`.
LEAD_TIME_DAYS=7
SERVICE_LEVEL=0.95
HOLDING_COST=0.2
STOCKOUT_COST=1.0

# --- Access control ---------------------------------------------------------
# AUTH_MODE=off (default): open API. If API_KEY is set, callers may still
#                          use the X-API-Key header; without it, /api/* is
#                          open to the local network.
# AUTH_MODE=demo:          require login. Credentials come from
#                          DEMO_USER / DEMO_PASSWORD. Sessions are signed
#                          with SESSION_SECRET.
AUTH_MODE=off
API_KEY=
DEMO_USER=demo
DEMO_PASSWORD=
SESSION_SECRET=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins for browser requests.
ALLOWED_ORIGINS=http://localhost:3000

# --- Logging ----------------------------------------------------------------
# LOG_JSON is parsed and validated now; structured JSON logging will be wired
# in a later production-observability pass.
LOG_LEVEL=INFO
LOG_JSON=false

# --- Persistence ------------------------------------------------------------
# Target SQLAlchemy database URL. Production and Docker use PostgreSQL through
# the sync psycopg2 driver.
# For local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://supplysync:supplysync@localhost:5432/supplysync
DATABASE_URL=sqlite:///backend/data/supplysync.db

# --- Bring your own data (optional) -----------------------------------------
# Override the default data/raw/online_retail_II.csv path for training and
# evaluation. When DATA_CSV_PATH is set, `load_and_clean_retail_data()`
# reads from there instead of the UCI default. See
# docs/bring-your-own-data.md for worked examples.
# DATA_CSV_PATH=/absolute/path/to/your.csv
#
# Override the processed parquet path used by evaluate_forecast.py and
# evaluate_cross_sku.py. Defaults to data/processed/daily_demand.parquet.
# DATA_PARQUET_PATH=/absolute/path/to/your.parquet
